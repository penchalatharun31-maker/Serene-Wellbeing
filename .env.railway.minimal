# ============================================
# MINIMAL FRONTEND CONFIGURATION FOR RAILWAY
# ============================================
# Copy these variables to Railway Dashboard → Variables
# These are the MINIMUM required variables to get the frontend running

# ==========================================
# Backend API URL (Required)
# ==========================================
# CRITICAL: Set this to your backend Railway URL + /api/v1
# Get this AFTER deploying backend first
# Format: https://your-backend-service.up.railway.app/api/v1
VITE_API_URL=https://your-backend-service.up.railway.app/api/v1

# ==========================================
# Application Info
# ==========================================
VITE_APP_NAME=Serene Wellbeing Hub
VITE_APP_VERSION=1.0.0
VITE_SUPPORT_EMAIL=support@serenewellbeing.com

# ==========================================
# Feature Flags
# ==========================================
VITE_ENABLE_CHAT=true
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_GROUP_SESSIONS=true

# ==========================================
# Debug Mode (OFF in production)
# ==========================================
VITE_DEBUG=false

# ============================================
# OPTIONAL VARIABLES
# ============================================
# These are optional - add them when you set up payment gateways

# Payment - Razorpay (Optional - for India)
# VITE_RAZORPAY_KEY_ID=rzp_test_...

# Payment - Stripe (Optional - for International)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Analytics (Optional)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_GOOGLE_TAG_MANAGER_ID=

# Error Tracking (Optional)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
