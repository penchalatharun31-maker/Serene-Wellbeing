# ============================================
# MINIMAL BACKEND CONFIGURATION FOR RAILWAY
# ============================================
# Copy these variables to Railway Dashboard → Variables
# These are the MINIMUM required variables to get the backend running

# ==========================================
# Environment
# ==========================================
NODE_ENV=production
PORT=5000
API_VERSION=v1

# ==========================================
# Database (Required)
# ==========================================
# Get from MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster.mongodb.net/serene-wellbeing

# ==========================================
# Redis (Required)
# ==========================================
# Option 1: Use Railway Redis Add-on (recommended)
#   - Go to Railway Dashboard → Add Redis
#   - This variable will be auto-populated
# Option 2: Use external Redis (e.g., Upstash, Redis Cloud)
REDIS_URL=redis://default:password@host:port

# ==========================================
# JWT Secrets (Required)
# ==========================================
# Generate with: openssl rand -base64 64
# IMPORTANT: Use different secrets for each!
JWT_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_64>
JWT_REFRESH_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_64>
SESSION_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_64>

# ==========================================
# AI - Google Gemini (Required)
# ==========================================
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash-exp

# ==========================================
# Frontend URL (Required)
# ==========================================
# Set this to your Railway frontend URL after deploying frontend
# Format: https://your-frontend.up.railway.app (no trailing slash)
FRONTEND_URL=https://your-frontend-service.up.railway.app

# ============================================
# OPTIONAL VARIABLES
# ============================================
# These are optional - features will work without them but with limited functionality

# Payment - Stripe (Optional - for international payments)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Payment - Razorpay (Optional - for India payments)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# Google OAuth (Optional - for social login)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_CALLBACK_URL=https://your-backend.up.railway.app/api/v1/auth/google/callback

# Email (Optional - for notifications)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
